<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            style="@style/VaultLargeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New login"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/group_bg"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etTitle"
                style="@style/VaultField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:inputType="textCapWords" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:background="@color/separator" />

            <EditText
                android:id="@+id/etDomain"
                style="@style/VaultField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Website, e.g. github.com"
                android:inputType="textUri" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:background="@color/separator" />

            <EditText
                android:id="@+id/etUser"
                style="@style/VaultField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username or email"
                android:inputType="textNoSuggestions" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:background="@color/separator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPass"
                    style="@style/VaultField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Password"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/tvShow"
                    style="@style/VaultHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Show"
                    android:textColor="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvGenerate"
            style="@style/VaultHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="4dp"
            android:text="Generate strong password"
            android:textColor="@color/accent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tvStrength"
            style="@style/VaultCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvBreach"
            style="@style/VaultCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/accent"
            android:text="Save"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            app:cornerRadius="14dp" />

        <LinearLayout
            android:id="@+id/totpBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/group_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/VaultCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification code" />

            <TextView
                android:id="@+id/tvTotpCode"
                style="@style/VaultLargeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="------"
                android:textSize="32sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/totpBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />

            <TextView
                android:id="@+id/tvTotpTime"
                style="@style/VaultCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTotpCopy"
                    style="@style/VaultHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="Copy code"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/btnTotpRemove"
                    style="@style/VaultHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Remove"
                    android:textColor="@color/danger" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnTotp"
            style="@style/VaultHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="14dp"
            android:text="Set up verification code"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnFix"
            style="@style/VaultHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="14dp"
            android:text="Change password on website"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCopy"
            style="@style/VaultHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:padding="14dp"
            android:text="Copy password"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnDelete"
            style="@style/VaultHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="14dp"
            android:text="Delete login"
            android:textColor="@color/danger"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>